# The installers are checked byte-for-byte by tests/test_windows_install_path.py
# and are served raw to `sh` and `iex` pipelines, so their line endings have to
# be the same on every checkout. Without this, git's Windows autocrlf rewrites
# install.ps1 to CRLF on checkout and the encoding gate fails on windows-latest.
install.sh  text eol=lf
install.ps1 text eol=lf

# Generated skill bodies and references are compared byte-for-byte against their
# producers (tests/test_agent_board_kanban.py K7, docs --check gates), so their
# line endings must be identical on every checkout.
skills/**/*.md text eol=lf
agent-skills/**/*.md text eol=lf

# Generated clone adapters are byte-gated on POSIX and Windows. Keep scripts
# (PowerShell 5.1/7 accept LF) AND JSON inventories independent of autocrlf.
.cursor/install.sh text eol=lf
.cursor/install.ps1 text eol=lf
.cursor/manifest.json text eol=lf
.claude/install.sh text eol=lf
.claude/install.ps1 text eol=lf
.claude/manifest.json text eol=lf
.codex/install.sh text eol=lf
.codex/install.ps1 text eol=lf
.codex/manifest.json text eol=lf
.opencode/install.sh text eol=lf
.opencode/install.ps1 text eol=lf
.opencode/manifest.json text eol=lf
.openclaw/install.sh text eol=lf
.openclaw/install.ps1 text eol=lf
.openclaw/manifest.json text eol=lf
.pi/install.sh text eol=lf
.pi/install.ps1 text eol=lf
.pi/manifest.json text eol=lf
docs/WORKFLOWS.md text eol=lf
docs/ROLES.md text eol=lf
src/plugin_bundle/omh/tools/capability_families.json text eol=lf
examples/**/*.json text eol=lf
